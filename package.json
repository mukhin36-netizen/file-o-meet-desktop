{
  "name": "file-o-meeting",
  "productName": "FILE-O Meeting",
  "version": "0.6.1",
  "description": "Приложение для записи системного звука видеовстреч и транскрибации в FILE-O",
  "author": "FILE-O",
  "private": true,
  "main": "main.cjs",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack:windows": "electron-packager . FILE-O-Meeting --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/fileo.ico",
    "pack:mac-arm": "electron-packager . FILE-O-Meeting --platform=darwin --arch=arm64 --out=dist --overwrite --icon=assets/fileo.icns",
    "pack:mac-intel": "electron-packager . FILE-O-Meeting --platform=darwin --arch=x64 --out=dist --overwrite --icon=assets/fileo.icns"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.3.2",
    "jsdom": "^26.1.0"
  }
}
